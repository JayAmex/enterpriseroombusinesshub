# Database Configuration
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# JWT Secret
JWT_SECRET=your-jwt-secret-key-change-in-production

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Email verification (verification link sender)
SITE_URL=http://localhost:3000
MAIL_FROM=register@enterpriserm.com
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=register@enterpriserm.com
SMTP_PASS=your-mailbox-password

# Welcome email (no_reply@, same SMTP server)
NOREPLY_MAIL_FROM=no_reply@enterpriserm.com
NOREPLY_SMTP_USER=no_reply@enterpriserm.com
NOREPLY_SMTP_PASS=your-no-reply-password
